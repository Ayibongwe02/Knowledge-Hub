# Copy to .env for local Docker (never commit .env). Render does NOT read this file;
# on Render these values come from render.yaml.

# --- Required for sign-in ---
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=
# Exact origin you open in the browser. Local Docker: http://localhost:10000
# On Render's default onrender.com URL leave this unset.
BETTER_AUTH_URL=http://localhost:10000

# --- Database ---
# Leave empty to use embedded PGLite (local only).
# Postgres example: postgres://hub:hub@db:5432/knowledge_hub
# Never put a real database URL or password in this file.
DATABASE_URL=

# Optional: PGLite storage path when DATABASE_URL is empty (Docker default)
# PGLITE_DATA_DIR=/app/data/pglite

# Optional local Postgres overlay password (docker-compose.postgres.yml)
# POSTGRES_PASSWORD=hub

# Optional speech-to-text keys (can also be entered in the UI). Keep blank here.
# VITE_DEEPGRAM_API_KEY=
# VITE_WHISPER_API_KEY=
